---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import BrassArt from '../components/BrassArt.astro';
import JoinBanner from '../components/JoinBanner.astro';
import { site, events } from '../data/site';
const next = [...events].filter(e => e.date >= new Date().toISOString().slice(0, 10)).sort((a,b) => a.date.localeCompare(b.date))[0];
---
<Layout>
  <section class="home-hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow"><span></span>WIR SIND DIE BLASKAPELLE GAUSTADT</p><h1>Heimat im Herzen.<br /><em>Musik im Blut.</em></h1><p>Wenn aus vielen Tönen ein Miteinander wird.<br class="desktop-break" /> Entdecke unsere Kapelle und die Freude an der Blasmusik.</p><div class="hero-actions"><a href="/kapelle/" class="button button-gold">Unsere Kapelle <Icon /></a><a href="/termine/" class="text-link">Live erleben <Icon name="diagonal" size={17} /></a></div><div class="hero-location"><Icon name="pin" size={17} /> DAHEIM IN GAUSTADT · BAMBERG</div></div><div class="hero-art"><BrassArt /><div class="round-seal"><span>BLASMUSIK</span><Icon name="heart" size={25} /><span>VERBINDET</span></div></div></div><div class="hero-bottom container"><span>TRADITION IM TAKT. GEMEINSCHAFT IM HERZEN.</span><a href="#kennenlernen">LERNE UNS KENNEN <span aria-hidden="true">↓</span></a></div></section>
  <div class="values-strip"><div class="container"><span><Icon name="music" /> Musik, die Freude macht</span><span><Icon name="heart" /> Gemeinschaft, die bleibt</span><span><Icon name="pin" /> Verwurzelt in Gaustadt</span></div></div>
  <section id="kennenlernen" class="section container about-grid"><div class="about-visual"><div class="poster-top">GAUSTADT <span>♪</span> KLINGT.</div><div class="poster-word">Viele Töne.<br />Ein <em>Wir.</em></div><div class="poster-lines" aria-hidden="true"><span>♪</span><span>♫</span><span>♪</span></div><div class="poster-bottom">UNSERE LEIDENSCHAFT? MUSIK & MITEINANDER.</div><div class="little-tag">Schön, dass du da bist!</div></div><div class="about-copy"><p class="eyebrow">DIE MENSCHEN HINTER DER MUSIK</p><h2>Mehr als Musik.<br />Ein Stück Zuhause.</h2><p>Blasmusik lebt von den Menschen, die sie machen. Von der Freude am Zusammenspielen und von Momenten, die man miteinander teilt.</p><p>Wir möchten dir zeigen, wer hinter der Blaskapelle Gaustadt steckt. Lerne uns kennen – oder finde selbst deinen Platz in der Kapelle.</p><a class="text-link dark" href="/kapelle/">Mehr über uns <Icon /></a></div></section>
  <section class="events-section"><div class="container"><div class="section-title"><div><p class="eyebrow">SEHEN. HÖREN. DABEI SEIN.</p><h2>Wir sehen uns vor der Bühne.</h2></div><a class="text-link dark" href="/termine/">Alle Termine <Icon /></a></div>{next ? <a href="/termine/" class="upcoming-card"><div class="event-date"><strong>{new Date(next.date+'T12:00:00').getDate()}</strong><span>{new Intl.DateTimeFormat('de-DE',{month:'short'}).format(new Date(next.date+'T12:00:00'))}</span></div><div><p class="eyebrow">NÄCHSTER AUFTRITT</p><h3>{next.title}</h3><p>{next.place} · {next.time} Uhr</p></div><Icon name="arrow" size={28} /></a> : <div class="upcoming-card"><div class="event-date empty-date"><Icon name="calendar" size={30} /></div><div><p class="eyebrow">UNSER TERMINKALENDER</p><h3>Die nächsten Auftritte folgen.</h3><p>Sobald Termine bestätigt sind, findest du sie hier. Bis dahin gibt’s Neuigkeiten auf Instagram.</p></div><a href={site.instagram} class="circle-link" target="_blank" rel="noopener noreferrer" aria-label="Neuigkeiten auf Instagram (öffnet in einem neuen Tab)"><Icon name="diagonal" size={25} /></a></div>}</div></section>
  <section class="section container discover-section"><div class="section-title"><div><p class="eyebrow">NOCH EIN BISSCHEN NÄHER DRAN</p><h2>Entdecke unsere Welt.</h2></div><span class="small-note">Musik. Menschen. Gute Momente.</span></div><div class="discover-grid"><a href="/galerie/" class="discover-card"><div class="card-art gallery-art"><div class="photo-frame frame-back"><span>♫</span></div><div class="photo-frame frame-front"><span>♪</span><small>GAUSTADT</small></div><span class="art-label">MOMENTE, DIE BLEIBEN</span></div><div class="card-body"><span class="eyebrow">BILDER & EINDRÜCKE</span><h3>Ein Blick ins Kapellenleben. <Icon name="diagonal" /></h3><p>Unsere Bildergalerie und aktuelle Einblicke.</p></div></a><a href="/mitmachen/" class="discover-card"><div class="card-art join-art"><span class="big-notes">♪<span>♫</span></span><span class="art-label">DEIN TON FEHLT NOCH.</span></div><div class="card-body"><span class="eyebrow">MITMACHEN</span><h3>Spiel mit. Sei dabei. <Icon name="diagonal" /></h3><p>Ein Instrument, viele Möglichkeiten, ein Miteinander.</p></div></a><a href="/kontakt/?anliegen=auftritt" class="discover-card"><div class="card-art booking-art"><div class="concert-ticket"><span>LIVE & MIT HERZ</span><strong>Ein Fest.<br />Unser Klang.</strong><i>BLASKAPELLE GAUSTADT</i></div><span class="art-label">MUSIK FÜR EURE MOMENTE</span></div><div class="card-body"><span class="eyebrow">AUFTRITT ANFRAGEN</span><h3>Ihr feiert. Wir spielen? <Icon name="diagonal" /></h3><p>Erzählt uns von eurer Veranstaltung.</p></div></a></div></section>
  <JoinBanner />
</Layout>
