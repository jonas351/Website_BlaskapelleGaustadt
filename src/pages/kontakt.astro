---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---
<Layout title="Kontakt & Anfragen" description="Kontakt zur Blaskapelle Gaustadt: Auftritt anfragen, mitmachen oder eine Frage stellen.">
  <PageHeading label="KONTAKT" title="Der gute Ton beginnt mit einem Hallo." text="Eine Frage, eine Idee oder ein Fest in Planung? Wir freuen uns, von dir zu hören." />
  <section class="section container contact-grid"><aside class="contact-sidebar"><p class="eyebrow">SO ERREICHST DU UNS</p><h2>Lass uns reden.</h2><p>Für Auftritte, fürs Mitspielen und für alles, was du uns gerne sagen möchtest.</p><div class="contact-method"><Icon name="mail" /><div><h3>E-Mail</h3>{site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : <p class="placeholder">[Kontakt-E-Mail ergänzen]</p>}</div></div><div class="contact-method"><Icon name="instagram" /><div><h3>Instagram</h3><a href={site.instagram} target="_blank" rel="noopener noreferrer">{site.instagramHandle} ↗<span class="sr-only"> (öffnet in einem neuen Tab)</span></a></div></div><div class="contact-method"><Icon name="pin" /><div><h3>Unser Probenraum</h3><p class="placeholder">{site.rehearsalPlace}</p></div></div>{site.phone && <div class="contact-method"><Icon name="heart" /><div><h3>Telefon</h3><a href={`tel:${site.phone.replace(/[^+\d]/g,'')}`}>{site.phone}</a></div></div>}<div class="contact-tip"><Icon name="music" /><p>Du möchtest mitspielen? Erzähl uns gerne, welches Instrument du spielst.</p></div></aside><div class="contact-form-panel"><h2>Was liegt dir auf dem Herzen?</h2><p>{site.email ? 'Bereite deine Anfrage vor und öffne sie anschließend in deinem E-Mail-Programm.' : 'Bereite deine Nachricht hier vor. Du kannst sie anschließend kopieren und uns auf Instagram senden.'}</p><form id="inquiry-form" data-email={site.email}><div class="form-row"><label for="name">Dein Name <span aria-hidden="true">*</span><input id="name" name="name" autocomplete="name" required maxlength="120" placeholder="Vor- und Nachname" /></label><label for="email">Deine E-Mail <span aria-hidden="true">*</span><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="Für unsere Rückmeldung" /></label></div><label for="subject">Worum geht’s? <span aria-hidden="true">*</span><select id="subject" name="subject" required><option value="Allgemeine Anfrage">Eine allgemeine Frage</option><option value="Auftrittsanfrage">Einen Auftritt anfragen</option><option value="Mitmachen">In der Kapelle mitmachen</option><option value="Unterstützung">Die Kapelle unterstützen</option></select></label><label for="message">Deine Nachricht <span aria-hidden="true">*</span><textarea id="message" name="message" rows="6" required minlength="10" maxlength="5000" placeholder="Erzähl uns ein bisschen mehr …"></textarea></label><p class="form-privacy">Deine Angaben werden hier nur im Browser zur Nachricht zusammengestellt. Übertragen werden sie erst, wenn du sie selbst per E-Mail oder auf Instagram sendest. <a href="/datenschutz/">Datenschutz</a></p><button class="button button-green" type="submit">Anfrage vorbereiten <Icon /></button><p class="required-note">* Pflichtfelder</p></form><section id="inquiry-result" class="inquiry-result" hidden aria-labelledby="result-title"><h3 id="result-title" tabindex="-1">Deine Nachricht ist vorbereitet.</h3><p>Es wurde noch nichts gesendet. Prüfe den Text und sende ihn anschließend an uns.</p><textarea id="prepared-message" aria-label="Vorbereitete Nachricht" rows="8" readonly></textarea><div class="result-actions"><button type="button" id="copy-message" class="button button-green"><Icon name="copy" size={17} /> Nachricht kopieren</button>{site.email ? <a id="send-email" class="text-link dark" href={`mailto:${site.email}`}>E-Mail-Programm öffnen <Icon name="diagonal" size={16} /></a> : <a class="text-link dark" href={site.instagram} target="_blank" rel="noopener noreferrer">Auf Instagram senden <Icon name="diagonal" size={16} /><span class="sr-only"> (öffnet in einem neuen Tab)</span></a>}</div><p id="copy-status" role="status" aria-live="polite"></p></section></div></section>
  <script>
    const form = document.querySelector<HTMLFormElement>('#inquiry-form');
    const subject = document.querySelector<HTMLSelectElement>('#subject');
    const query = new URLSearchParams(window.location.search).get('anliegen');
    if (subject && query === 'auftritt') subject.value = 'Auftrittsanfrage';
    if (subject && query === 'mitmachen') subject.value = 'Mitmachen';
    const result = document.querySelector<HTMLElement>('#inquiry-result');
    const prepared = document.querySelector<HTMLTextAreaElement>('#prepared-message');
    const status = document.querySelector<HTMLElement>('#copy-status');
    form?.addEventListener('submit', e => {
      e.preventDefault(); if (!form.reportValidity() || !result || !prepared) return;
      const data = new FormData(form);
      prepared.value = `${data.get('subject')}\n\nHallo Blaskapelle Gaustadt,\n\n${String(data.get('message')).trim()}\n\nViele Grüße\n${String(data.get('name')).trim()}\nE-Mail: ${String(data.get('email')).trim()}`;
      const send = document.querySelector<HTMLAnchorElement>('#send-email');
      if (send && form.dataset.email) send.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(String(data.get('subject')))}&body=${encodeURIComponent(prepared.value)}`;
      if (status) status.textContent = '';
      result.hidden = false; document.querySelector<HTMLElement>('#result-title')?.focus();
      result.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'nearest' });
    });
    document.querySelector('#copy-message')?.addEventListener('click', async () => {
      if (!prepared || !status) return;
      try { await navigator.clipboard.writeText(prepared.value); status.textContent = 'Kopiert! Du kannst die Nachricht jetzt einfügen und senden.'; }
      catch { prepared.focus(); prepared.select(); status.textContent = 'Bitte kopiere den markierten Text mit Strg+C oder über das Kopieren-Menü.'; }
    });
    form?.addEventListener('input', () => { if (result) result.hidden = true; });
  </script>
</Layout>
