                {
                  "id": "3f822970",
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<h4>Bamberg ist eine Stadt, die in ihrer 1000-jährigen Geschichte von christlichen Werten geprägt worden ist. Diese möchte ich wieder sichtbarer machen. In einem Bamberg, in dem Familien wieder finanzierbaren Wohnraum und einen Betreuungsplatz für ihre Kinder finden, in dem unsere Schülerinnen und Schüler in sanierten Schulhäusern lernen können, in dem wir neue Impulse im Umwelt- und Klimaschutz setzen und neue Wege in der Mobilität einschlagen. Kurzum: Ein Bamberg, in dem es wieder ein bisschen wärmer wird.</h4>",
                    "text_color": "#566779",
                    "typography_typography": "custom",
                    "typography_font_family": "Arial",
                    "typography_font_size": {
                      "unit": "px",
                      "size": 16
                    },
                    "typography_line_height": {
